animations {
  window-open {
    duration-ms 500
    curve "ease-out-cubic"

    custom-shader r"
        float hash(vec2 p) {
            // Faster pseudo-random hash with fewer heavy operations
            return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
        }

        float noise(vec2 p) {
            vec2 i = floor(p);
            vec2 f = fract(p);
            // Smoothstep equivalent formula optimized
            f = f * f * (3.0 - 2.0 * f);
            
            float a = hash(i);
            float b = hash(i + vec2(1.0, 0.0));
            float c = hash(i + vec2(0.0, 1.0));
            float d = hash(i + vec2(1.0, 1.0));
            return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
        }

        // Optimized FBM: Reduced from 6 octaves to 3 for massive speedups
        float fbm(vec2 p) {
            float v = 0.0;
            v += 0.5 * noise(p); p *= 2.02;
            v += 0.25 * noise(p); p *= 2.03;
            v += 0.125 * noise(p);
            return v * 1.1428; // Normalize
        }

        // Optimized WarpedFBM with fewer internal nested calls
        float warpedFbm(vec2 p, float t) {
            vec2 q = vec2(fbm(p), fbm(p + vec2(5.2, 1.3)));
            vec2 r = vec2(fbm(p + 3.0 * q + vec2(1.7, 9.2) + 0.15 * t),
                          fbm(p + 3.0 * q + vec2(8.3, 2.8) + 0.12 * t));
            return fbm(p + 4.0 * r);
        }

        vec4 open_color(vec3 coords_geo, vec3 size_geo) {
            float p = niri_clamped_progress;
            vec2 uv = coords_geo.xy;
            float seed = niri_random_seed * 15.0; // Scaled down to prevent precision artifacts

            float t = p * 8.0 + seed;
            float fluid = warpedFbm(uv * 1.5 + seed, t);

            vec2 center = uv - 0.5;
            float dist = length(center * vec2(1.0, 0.7));

            float appear = (1.0 - dist * 1.2) + (1.0 - fluid) * 0.7;
            float reveal = smoothstep(appear + 0.4, appear - 0.4, (1.0 - p) * 1.6);

            // Reusing a simplified single warp for texture distortion to save frames
            float distort_strength = (1.0 - p) * (1.0 - p) * 0.25;
            vec2 distortion = vec2(fbm(uv * 2.0 + vec2(0.0, t * 0.15)), 
                                   fbm(uv * 2.0 + vec2(4.0, t * 0.15)));
            vec2 warped_uv = uv + (distortion - 0.5) * distort_strength;

            vec3 tex_coords = niri_geo_to_tex * vec3(warped_uv, 1.0);
            return texture2D(niri_tex, tex_coords.st) * reveal;
        }
    "
  }

  window-close {
    duration-ms 500
    curve "ease-out-cubic"

    custom-shader r"
        float hash(vec2 p) {
            return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
        }

        float noise(vec2 p) {
            vec2 i = floor(p);
            vec2 f = fract(p);
            f = f * f * (3.0 - 2.0 * f);
            
            float a = hash(i);
            float b = hash(i + vec2(1.0, 0.0));
            float c = hash(i + vec2(0.0, 1.0));
            float d = hash(i + vec2(1.0, 1.0));
            return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
        }

        float fbm(vec2 p) {
            float v = 0.0;
            v += 0.5 * noise(p); p *= 2.02;
            v += 0.25 * noise(p); p *= 2.03;
            v += 0.125 * noise(p);
            return v * 1.1428;
        }

        float warpedFbm(vec2 p, float t) {
            vec2 q = vec2(fbm(p), fbm(p + vec2(5.2, 1.3)));
            vec2 r = vec2(fbm(p + 3.0 * q + vec2(1.7, 9.2) + 0.15 * t),
                          fbm(p + 3.0 * q + vec2(8.3, 2.8) + 0.12 * t));
            return fbm(p + 4.0 * r);
        }

        vec4 close_color(vec3 coords_geo, vec3 size_geo) {
            float p = niri_clamped_progress;
            vec2 uv = coords_geo.xy;
            float seed = niri_random_seed * 15.0;

            float t = p * 8.0 + seed;
            float fluid = warpedFbm(uv * 1.5 + seed, t);

            vec2 center = uv - 0.5;
            float dist = length(center * vec2(1.0, 0.7));

            float dissolve = (1.0 - dist) * 1.2 + fluid * 0.7;
            float remain = smoothstep(dissolve + 0.4, dissolve - 0.4, p * 1.6);

            float distort_strength = p * p * 0.3;
            vec2 distortion = vec2(fbm(uv * 2.0 + vec2(0.0, t * 0.15)), 
                                   fbm(uv * 2.0 + vec2(4.0, t * 0.15)));
            vec2 warped_uv = uv + (distortion - 0.5) * distort_strength;

            vec3 tex_coords = niri_geo_to_tex * vec3(warped_uv, 1.0);
            float tail = smoothstep(1.0, 0.8, p);
            
            return texture2D(niri_tex, tex_coords.st) * remain * tail;
        }
    "
  }
}